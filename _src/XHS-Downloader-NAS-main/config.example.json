{
  "api_url": "http://xhs-api:5556/xhs/detail",
  "database": "/state/xhs_queue.sqlite3",
  "queue_files": [
    "/queue/links.txt"
  ],
  "settings_path": "/xhs-volume/settings.json",
  "xhs_api_log_file": "/xhs-volume/xhs-api.log",
  "image_format": "AUTO",
  "request_delay_seconds": 0,
  "jitter_seconds": 0,
  "retry_failed": true,
  "max_download_attempts": 0,
  "max_items_per_run": 0,
  "api_skip_existing": true,
  "api_timeout_seconds": 120,
  "sync_settings": {
    "path": "/xhs-volume/settings.json",
    "defaults": {
      "work_path": "/xhs",
      "folder_mode": true,
      "download_record": true,
      "image_download": true,
      "video_download": true,
      "live_download": true,
      "image_format": "AUTO",
      "name_format": "发布时间 作者昵称 作品标题"
    }
  },
  "web": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8080,
    "log_lines": 5000
  }
}
